# Supabase (copy these values from your project's .env)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWKS_URI=https://your-project.supabase.co/auth/v1/.well-known/jwks.json
SUPABASE_JWT_AUDIENCE=authenticated

# JWT / Auth
SECRET_KEY=change-me-to-a-random-string

# PostgreSQL (used in Docker Compose)
POSTGRES_USER=invoiceflow
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5432

# CORS (comma-separated origins)
CORS_ORIGINS=http://localhost,http://localhost:3000,https://yourdomain.com,http://yourdomain.com

# Upload / PDF
UPLOAD_DIR=uploads
MAX_FILE_SIZE=10485760
